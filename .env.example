# Copy to .env — never commit .env. Values here are local-dev defaults, not secrets.
DATABASE_URL=postgresql+asyncpg://capsule:capsule@localhost:5432/capsule
REDIS_URL=redis://localhost:6379/0
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=eu-west-1
S3_MEDIA_BUCKET=capsule-media-dev
SQS_IMAGE_INGEST_URL=http://localhost:4566/000000000000/image-ingest
CLERK_SECRET_KEY=replace_me
CLERK_PUBLISHABLE_KEY=replace_me
CLERK_WEBHOOK_SECRET=replace_me
ANTHROPIC_API_KEY=replace_me
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LOG_LEVEL=INFO
# core-api: emit stable OTel HTTP metric names (http.server.request.duration)
OTEL_SEMCONV_STABILITY_OPT_IN=http
ENV=local
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
